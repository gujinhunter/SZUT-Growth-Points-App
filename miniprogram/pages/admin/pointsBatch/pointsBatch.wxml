<view class="page">
  <view class="card search-card">
    <view class="search-row">
      <input
        class="search-input"
        placeholder="姓名、学号、学院等"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <button class="search-btn" type="primary" size="mini" bindtap="onSearch" loading="{{searching}}">搜索</button>
    </view>
    <view class="hint-text">先搜索再勾选学生；单次最多 {{maxBatch}} 人，每人加相同分值。</view>
  </view>

  <view class="toolbar" wx:if="{{list.length}}">
    <button class="plain-btn" size="mini" bindtap="onSelectPage">全选本页</button>
    <button class="plain-btn" size="mini" bindtap="onClearSelection">清空选择</button>
    <text class="selected-label">已选 {{selectedCount}} 人</text>
  </view>

  <scroll-view scroll-y class="list-wrap" wx:if="{{list.length}}">
    <block wx:for="{{list}}" wx:key="_id">
      <view class="row" bindtap="onToggleRow" data-id="{{item._id}}">
        <view class="check {{selectedMap[item._id] ? 'on' : ''}}"></view>
        <view class="row-main">
          <text class="name">{{item.name}}</text>
          <text class="meta">{{item.studentId}} · 当前 {{item.totalPoints}} 分</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="empty card" wx:elif="{{!searching && searched}}">
    <text>未找到学生，请调整关键词</text>
  </view>

  <view class="empty card" wx:elif="{{!searched}}">
    <text>请输入关键词并点击「搜索」</text>
  </view>

  <view class="footer card" wx:if="{{searched}}">
    <view class="field-row">
      <text class="label">每人加分</text>
      <input class="num-input" type="number" placeholder="1～5000" value="{{pointsStr}}" bindinput="onPointsInput" />
    </view>
    <view class="field-row">
      <text class="label">备注</text>
      <input class="text-input" placeholder="选填，会显示在学生积分明细" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
    <button
      class="submit-btn"
      type="primary"
      loading="{{submitting}}"
      disabled="{{submitting || selectedCount === 0}}"
      bindtap="onSubmit"
    >
      确认加分
    </button>
  </view>
</view>
