.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 280rpx;
  background: #f3f5f9;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(31, 79, 163, 0.08);
  margin-bottom: 24rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
  font-size: 28rpx;
}

.search-btn {
  flex-shrink: 0;
}

.hint-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5c6684;
  line-height: 1.5;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.plain-btn {
  background: #eef2fb;
  color: #1f4e9d;
}

.selected-label {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f4e9d;
}

.list-wrap {
  max-height: calc(100vh - 520rpx);
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(31, 79, 163, 0.08);
  padding: 8rpx 0;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.row:last-child {
  border-bottom: none;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c5cedd;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.check.on {
  background: #1f4e9d;
  border-color: #1f4e9d;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2b4d;
}

.meta {
  font-size: 24rpx;
  color: #6c7c94;
}

.empty {
  text-align: center;
  color: #6c7c94;
  font-size: 26rpx;
  padding: 48rpx 24rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  margin: 0;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(31, 79, 163, 0.1);
}

.field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #2b4673;
  flex-shrink: 0;
}

.num-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
  font-size: 28rpx;
}

.text-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2c4f86 0%, #345f9e 100%);
}
